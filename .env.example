# Copy to .env.local and fill in. Never commit the real file.

# Login: Better Auth with Google (see README: "Accounts, data and photos")
BETTER_AUTH_SECRET=        # random: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database: Neon Postgres. Pooled for the app, direct for `npm run db:migrate`.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Photos: S3 bucket served through CloudFront. Locally an IAM user's keys; on Vercel, OIDC (AWS_ROLE_ARN).
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
PHOTOS_URL=                # https://xxxx.cloudfront.net

# CV import: the OpenAI key (https://platform.openai.com/api-keys). Without it the import says it isn't set up.
OPENAI_API_KEY=
# Optional, defaults to gpt-6-luna.
OPENAI_MODEL=

# Optional: profiles on subdomains (andrea.devtag.io), which needs the domain on Vercel with a wildcard.
# Empty: profiles are paths on the same site (/andrea).
# To try subdomains locally: localhost:3000, then open http://andrea.localhost:3000 (Chrome or Firefox).
NEXT_PUBLIC_ROOT_DOMAIN=
